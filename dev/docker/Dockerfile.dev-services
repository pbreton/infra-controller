ARG CONTAINER_BUILD=nico-dev-build
ARG CONTAINER_RUNTIME=nico-dev-runtime
# Native QEMU/UEFI pair used by both target architectures.
ARG BMC_TARGET_BASE=ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

FROM ${CONTAINER_BUILD} AS source

ARG TARGETARCH

ENV CARGO_HOME=/cargo-home
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV CARGO_TARGET_DIR=/cargo-target
ENV CARGO_PROFILE_DEV_DEBUG=line-tables-only
ENV CARGO_PROFILE_RELEASE_DEBUG=line-tables-only

WORKDIR /workspace
COPY . .

FROM source AS api-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked \
    -p carbide-api --bin carbide-api \
    -p nico-admin-cli --bin nico-admin-cli \
    && mkdir -p /out \
    && cp /cargo-target/debug/carbide-api /out/carbide-api \
    && cp /cargo-target/debug/nico-admin-cli /out/nico-admin-cli

FROM source AS bmc-proxy-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked -p carbide-bmc-proxy --bin carbide-bmc-proxy \
    && mkdir -p /out \
    && cp /cargo-target/debug/carbide-bmc-proxy /out/carbide-bmc-proxy

FROM source AS dhcp-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked -p carbide-dhcp --lib \
    && mkdir -p /out \
    && cp /cargo-target/debug/libdhcp.so /out/libdhcp.so

FROM source AS machine-a-tron-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked -p carbide-machine-a-tron --bin machine-a-tron \
    && mkdir -p /out \
    && cp /cargo-target/debug/machine-a-tron /out/machine-a-tron

FROM source AS ssh-console-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked -p carbide-ssh-console --bin ssh-console \
    && mkdir -p /out \
    && cp /cargo-target/debug/ssh-console /out/ssh-console

FROM source AS mat-protocol-gateway-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked --release -p carbide-mat-protocol-gateway --bin mat-protocol-gateway \
    && mkdir -p /out \
    && cp /cargo-target/release/mat-protocol-gateway /out/mat-protocol-gateway

FROM source AS nico-postgres-exporter-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked --release -p nico-postgres-exporter --bin nico-postgres-exporter \
    && mkdir -p /out \
    && cp /cargo-target/release/nico-postgres-exporter /out/nico-postgres-exporter

FROM ${CONTAINER_RUNTIME} AS api

RUN apt-get update && apt-get install -y --no-install-recommends \
  curl \
  ipmitool \
  iproute2 \
  iputils-ping \
  libudev1 \
  tpm2-tools \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/carbide /opt/carbide/firmware /mnt/persistence /var/run/kea

COPY --from=api-builder /out/carbide-api /opt/carbide/carbide-api
COPY --from=api-builder /out/nico-admin-cli /opt/carbide/nico-admin-cli
COPY crates/api/casbin-policy.csv /opt/carbide/casbin-policy.csv

ENV CASBIN_POLICY_FILE=/opt/carbide/casbin-policy.csv
ENV PATH /opt/carbide:$PATH

FROM ${CONTAINER_RUNTIME} AS bmc-proxy

RUN mkdir -p /opt/carbide /mnt/persistence

COPY --from=bmc-proxy-builder /out/carbide-bmc-proxy /opt/carbide/carbide-bmc-proxy

FROM ${CONTAINER_RUNTIME} AS dhcp

ARG KEA_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
  curl \
  iproute2 \
  kea-dhcp4-server=${KEA_VERSION} \
  kea-dhcp6-server=${KEA_VERSION} \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /usr/lib/kea/hooks /var/lib/kea /var/run/kea

COPY --from=dhcp-builder /out/libdhcp.so /usr/lib/kea/hooks/libdhcp.so

FROM ${CONTAINER_RUNTIME} AS machine-a-tron

RUN apt-get update && apt-get install -y --no-install-recommends \
  ipmitool \
  iproute2 \
  iputils-ping \
  libssl3 \
  libudev1 \
  openipmi \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/machine-a-tron/bin /tmp/machine-a-tron-data

COPY --from=machine-a-tron-builder /out/machine-a-tron /opt/machine-a-tron/bin/machine-a-tron
COPY crates/bmc-mock/dell_poweredge_r750.tar.gz /opt/machine-a-tron/dell_poweredge_r750.tar.gz
COPY crates/bmc-mock/nvidia_dpu.tar.gz /opt/machine-a-tron/nvidia_dpu.tar.gz

FROM ${CONTAINER_RUNTIME} AS ssh-console

RUN apt-get update && apt-get install -y --no-install-recommends ipmitool libudev1 libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ssh-console-builder /out/ssh-console /opt/carbide/ssh-console

FROM ${CONTAINER_RUNTIME} AS mat-protocol-gateway

COPY --from=mat-protocol-gateway-builder /out/mat-protocol-gateway /mat-protocol-gateway

FROM ${CONTAINER_RUNTIME} AS nico-postgres-exporter
COPY --from=nico-postgres-exporter-builder /out/nico-postgres-exporter /usr/local/bin/nico-postgres-exporter

USER 65534:65534

FROM source AS bmc-mock-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked -p bmc-mock --bin bmc-mock \
    && mkdir -p /out \
    && cp /cargo-target/debug/bmc-mock /out/bmc-mock

FROM ${BMC_TARGET_BASE} AS bmc-target

ARG DEBIAN_FRONTEND=noninteractive

RUN case "$(dpkg --print-architecture)" in \
      amd64) packages="qemu-system-x86 ovmf ipxe-qemu" ;; \
      arm64) packages="qemu-system-arm qemu-efi-aarch64" ;; \
      *) exit 1 ;; \
    esac && apt-get update && apt-get install -y --no-install-recommends \
    libvirt-daemon-system libvirt-clients qemu-utils ${packages} python3 iproute2 iptables isc-dhcp-relay tini ca-certificates libssl3 libudev1 \
    && rm -rf /var/lib/apt/lists/* \
    && printf '%s\n' 'user = "root"' 'group = "root"' 'security_driver = "none"' \
       'cgroup_controllers = []' > /etc/libvirt/qemu.conf \
    && printf '%s\n' 'auth_unix_rw = "none"' > /etc/libvirt/libvirtd.conf \
    && rm -rf /etc/libvirt/qemu /var/lib/libvirt /var/log/libvirt \
    && ln -s /data/domains /etc/libvirt/qemu \
    && ln -s /data/libvirt /var/lib/libvirt \
    && ln -s /data/logs /var/log/libvirt

COPY --from=bmc-mock-builder /out/bmc-mock /usr/local/bin/bmc-mock
COPY crates/bmc-mock/tls.crt crates/bmc-mock/tls.key /opt/carbide/
COPY dev/deployment/lab/preflight.py dev/deployment/lab/target.py dev/deployment/lab/network.py /opt/nico-lab/
ENTRYPOINT ["/usr/bin/tini", "--", "python3", "-B", "/opt/nico-lab/target.py"]
