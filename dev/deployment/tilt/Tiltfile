stack_readiness_command = [
    'python3', stack_verifier, '--context', cluster_context, '--core-namespace', core_namespace,
    '--mat-service', 'nico-machine-a-tron-%s-bmc-mock' % machine_a_tron_dhcp_pod,
]
stack_readiness_dependencies = ['nico-machine-a-tron', 'nico-api']
if enable_rest:
    stack_readiness_command.extend(['--rest', '--rest-namespace', rest_namespace])
    stack_readiness_dependencies.append('nico-rest-site-agent')
    if enable_mcp:
        stack_readiness_dependencies.append('nico-mcp')
local_resource(
    'stack-ready',
    stack_readiness_command,
    deps=[stack_verifier, os.path.join(repo_root, 'dev/deployment/core-admin.sh')],
    resource_deps=stack_readiness_dependencies,
    labels=['application'],
)

