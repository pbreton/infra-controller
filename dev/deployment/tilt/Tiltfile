postgres_values = tilt_values['postgres']
postgres_values['cluster']['monitoring']['enabled'] = enable_observability
if not enable_rest:
    postgres_values['cluster']['roles'] = []
if enable_observability:
    # CNPG manages the preload library and extension when this parameter is set.
    pg_config = postgres_values['cluster'].setdefault('postgresql', {})
    pg_parameters = pg_config.setdefault('parameters', {})
    pg_parameters['pg_stat_statements.track'] = 'top'
    # Utility statements can contain passwords in the exported query label.
    pg_parameters['pg_stat_statements.track_utility'] = 'off'
    # The application owner also monitors statements issued by the other dev roles.
    postgres_values['cluster']['roles'].append({
        'name': postgres_values['cluster']['initdb']['owner'],
        'ensure': 'present',
        'login': True,
        'inRoles': ['pg_read_all_stats'],
    })

