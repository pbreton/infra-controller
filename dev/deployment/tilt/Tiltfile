# The shared prerequisite chart owns trust, connection settings and Core keys.
helm_resource(
    name='nico-core-prereqs',
    pod_readiness='ignore',
    chart=os.path.join(repo_root, 'helm-prereqs'),
    release_name='nico-core-prereqs',
    namespace=core_namespace,
    deps=[os.path.join(repo_root, 'helm-prereqs'), values_file,
          os.path.join(repo_root, 'dev/certs/localhost/ca.crt'),
          os.path.join(repo_root, 'dev/certs/localhost/ca.key'),
          os.path.join(repo_root, 'crates/ssh-console/tests/fixtures/ssh_host_ed25519_key'),
          os.path.join(repo_root, 'crates/ssh-console/tests/fixtures/ssh_host_ed25519_key.pub')],
    resource_deps=['cert-manager', vault_ready] + (['nico-local-namespaces'] if enable_rest else []),
    labels=['infrastructure'],
    flags=[
        '--create-namespace', '--wait', '--timeout=5m',
        '--values', prereqs_values_file,
        '--set-file', 'certManager.localCA.certificate=%s' % os.path.join(repo_root, 'dev/certs/localhost/ca.crt'),
        '--set-file', 'certManager.localCA.privateKey=%s' % os.path.join(repo_root, 'dev/certs/localhost/ca.key'),
        '--set-file', 'sshHostKey.privateKey=%s' % os.path.join(repo_root, 'crates/ssh-console/tests/fixtures/ssh_host_ed25519_key'),
        '--set-file', 'sshHostKey.publicKey=%s' % os.path.join(repo_root, 'crates/ssh-console/tests/fixtures/ssh_host_ed25519_key.pub'),
    ] + helm_json_flags({'vault': {'tokenSecret': {'create': not persistent_vault}}}) + helm_json_flags({'certManager': {'localCA': {'rest': {
        'enabled': enable_rest,
        'namespace': rest_namespace,
        'temporalNamespace': temporal_namespace,
        'issuerName': rest_global['certificate']['issuerRef']['name'],
    }}}}),
)

